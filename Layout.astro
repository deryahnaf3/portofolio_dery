---
interface Props {
  title: string;
  description?: string;
}

const { 
  title = "Dery Ahnaf Rashad | Industrial Electrical Engineering Portfolio", 
  description = "Portofolio Dery Ahnaf Rashad - Mahasiswa D3 Teknik Elektro Industri PENS." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-industrial-navy text-slate-100 font-sans antialiased selection:bg-brand-500 selection:text-white min-h-screen relative overflow-x-hidden">
    <!-- Ambient ambient gradients -->
    <div class="fixed top-0 left-1/4 w-96 h-96 bg-brand-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="fixed top-1/3 right-10 w-80 h-80 bg-accent-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="fixed bottom-20 left-1/3 w-96 h-96 bg-industrial-gold/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <slot />
  </body>
</html>
